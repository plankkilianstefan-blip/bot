# Kopiere diese Datei nach .env und trage deine Werte ein:  cp .env.example .env

# --- Datenquellen ---------------------------------------------------------
# Eigener RPC dringend empfohlen (öffentlicher RPC ist stark rate-limitiert), z.B. Helius:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=DEIN_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Bubblemaps V2 Data API Key (nötig für verbundene Wallets / Cluster)
BUBBLEMAPS_API_KEY=
# Optional: X/Twitter API Bearer Token für Follower-Zahlen
X_BEARER_TOKEN=

# --- Benachrichtigungen aufs Handy ---------------------------------------
# SMS über Twilio
ALERT_PHONE_NUMBER=+43XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Telegram (kostenlos, inkl. Diagramm-Bild): Bot via @BotFather, Chat-ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy Push (kostenlos, App "ntfy" installieren und Topic abonnieren – Topic geheim halten!)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Strategie ------------------------------------------------------------
MIN_LIQUIDITY_USD=10000
MAX_RISK=50
MIN_SCORE=65
ALERT_COOLDOWN_HOURS=12
SCAN_INTERVAL_SEC=60
REANALYZE_AFTER_MIN=30

# --- Wallet-Tracking ------------------------------------------------------
WALLETS_FILE=wallets.json
WALLET_INTERVAL_SEC=120
WALLET_ALERTS=true
# Whale-Alerts erst ab dieser SOL-Menge
WALLET_ALERT_MIN_SOL=1
# "wallets discover": Holder mit Bestand >= diesem USD-Wert gelten als "gross"
WHALE_USD_THRESHOLD=10000
